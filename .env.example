# ---- Backend ---------------------------------------------------------------
# Comma-separated key pool (at least 2). Key ids are key_1, key_2, ... in this order.
# Get free Gemini keys at https://aistudio.google.com/apikey (use keys from different projects).
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2

# Any LiteLLM model string. Check it is available to your keys in AI Studio.
LLM_MODEL=gemini/gemini-3.5-flash-lite

# SQLite location. In Docker this sits on the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db

# Comma-separated browser origins allowed to call the API (your deployed frontend URL goes here too).
ALLOWED_ORIGINS=http://localhost:3000

# true enables the X-Simulate-Failure header (must be true on the deployed backend for the demo).
ENABLE_FAILURE_SIMULATION=true

# ---- Backend, optional -----------------------------------------------------
# Port the backend listens on (Render/Railway/Fly inject their own $PORT).
PORT=8000
# Point LiteLLM at an OpenAI-compatible endpoint (use an "openai/<model>" LLM_MODEL with it).
LLM_API_BASE=
CACHE_ENABLED=true
# A key that really failed (429/quota/5xx) is skipped for this long before being tried first again.
KEY_COOLDOWN_SECONDS=60
REQUEST_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0
# Most recent messages sent to the model per request (full history stays in SQLite).
MAX_HISTORY_MESSAGES=40
# Leave empty for the provider default, or set a cap (also part of the cache key).
LLM_MAX_OUTPUT_TOKENS=
# Override the built-in default system prompt for new sessions.
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.

# ---- Frontend --------------------------------------------------------------
# Public URL of the backend as seen from the browser.
#   Docker: read at container start (API_URL).  Vercel/Netlify: set VITE_API_URL at build time.
API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
